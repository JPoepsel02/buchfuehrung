{
  "name": "kassenwart",
  "version": "1.17.4",
  "description": "Buchführung und Vereinszentrale",
  "main": "out/main/index.js",
  "author": "Buchführung contributors",
  "license": "MIT",
  "private": true,
  "overrides": {
    "image-size": "2.0.4"
  },
  "scripts": {
    "dev": "node scripts/seed-local.cjs && electron-vite dev",
    "build": "node scripts/build-production.cjs --local",
    "preview:web": "vite --config vite.web.config.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run build && npm run build:production && playwright test",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dist:mac": "npm run build:production && electron-builder --mac",
    "dist:win": "npm run build:production && electron-builder --win",
    "dist": "npm run build:production && electron-builder",
    "dev:web": "vite --config vite.web.config.ts --host 127.0.0.1 --port 5190 --strictPort",
    "build:production": "node scripts/build-production.cjs"
  },
  "dependencies": {
    "image-size": "2.0.4",
    "lib-fints": "^1.4.8",
    "pptxgenjs": "4.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.9",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
